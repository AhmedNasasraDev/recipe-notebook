S33.numbersOutsidePro: {"lines":83,"withNumbers":33,"sample":["12 יחידות","100 גר' ליחידה","2 שע' 12 דק'","נתונים חלקיים — חסרים נתונים עבור 2 רכיבים. סך המשקל, העלות והמחיר מחושבים מ-6 רכיבים בלבד ואינם מלאים.","938 גר'","12","8.2","12","500 גר'","10 גר'","60 גר'","15 גר'"]}
