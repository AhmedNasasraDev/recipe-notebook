{
  "name": "@recipe-notebook/engine",
  "version": "0.1.0",
  "description": "Unified calculation engine for Recipe Notebook: densities, unit conversion with provenance, personal calibration, recipe computation.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
