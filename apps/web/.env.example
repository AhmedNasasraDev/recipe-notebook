# Supabase. Copy to .env.local and fill in.
#
# The app runs WITHOUT these: with no configuration it serves the read-only demo
# repository and says so on screen. See src/lib/supabase.ts.
#
# PUBLISHABLE KEY ONLY (sb_publishable_... or a legacy anon JWT). Everything in
# this file is compiled into the browser bundle, so a privileged key here is a
# privileged key handed to every visitor. Row Level Security is what protects
# the data — not the key. src/lib/supabase.ts refuses both a service_role JWT
# and an sb_secret_ key, and there are tests for both (HANDOFF §6).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
